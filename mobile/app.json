{
  "expo": {
    "name": "Spot",
    "slug": "spot",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spot",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F3",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.meuspot.spot",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Spot usa sua localização para sugerir lugares perto de você e registrar check-in nos lugares que você visitou.",
        "NSCameraUsageDescription": "O Spot usa a câmera para você tirar foto de um lugar que salvou.",
        "NSPhotoLibraryUsageDescription": "O Spot acessa suas fotos para você escolher a imagem de um lugar ou do seu perfil.",
        "NSPhotoLibraryAddUsageDescription": "O Spot salva na sua galeria as imagens que você baixar do app.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:meuspot.app"
      ]
    },
    "android": {
      "package": "app.meuspot.spot",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3D2E"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Spot usa sua localização para sugerir lugares perto de você e registrar check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Spot acessa suas fotos para você escolher a imagem de um lugar ou do seu perfil.",
          "cameraPermission": "O Spot usa a câmera para você tirar foto de um lugar que salvou.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B3D2E",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "2929d3ae-246f-418c-a5df-25e9b6aac1c9"
      }
    },
    "owner": "lucaspatriarcha",
    "updates": {
      "url": "https://u.expo.dev/2929d3ae-246f-418c-a5df-25e9b6aac1c9",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
